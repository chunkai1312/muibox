{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "oxc", "import", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn",
    "pedantic": "off"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "ignorePatterns": ["lib", "docs", "node_modules", "storybook-static"],
  "rules": {
    "react/react-in-jsx-scope": "off",
    "typescript/no-unused-vars": [
      "error",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }
    ]
  },
  "overrides": [
    {
      "files": ["stories/**/*.tsx", ".storybook/**/*.{ts,tsx}"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
