{
  "name": "muibox",
  "version": "3.1.0",
  "packageManager": "bun@1.4.0",
  "type": "module",
  "description": "Promise-based dialog boxes (alert, confirm, prompt) using Material-UI",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "storybook": "storybook dev -p 9001",
    "build:storybook": "storybook build -o docs",
    "deploy:storybook": "gh-pages -d docs",
    "prebuild": "rimraf lib",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "bun run build",
    "lint": "oxlint --type-aware",
    "release": "release-it"
  },
  "files": [
    "lib"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chunkai1312/muibox.git"
  },
  "keywords": [
    "react",
    "material",
    "material-design",
    "material-ui",
    "mui",
    "dialog",
    "modal"
  ],
  "author": "Chun-Kai Wang <chunkai1312@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@release-it/conventional-changelog": "^12.0.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "gh-pages": "^6.3.0",
    "jsdom": "^26.1.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "release-it": "^21.0.2",
    "rimraf": "^6.1.3",
    "storybook": "^10.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@mui/material": "^9.4.0",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  }
}
